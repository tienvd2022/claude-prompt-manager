# Copy thành .env rồi sửa: cp .env.example .env
# Biến đặt từ ngoài (systemd, dòng lệnh) được ưu tiên hơn file này.
# Bỏ dấu # ở đầu dòng để bật. Dòng nào để nguyên # thì dùng giá trị mặc định.

# Thư mục chứa mọi dự án, mỗi thư mục con là một dự án. Hỗ trợ ~.
# Mặc định: ~/projects
# PROJECTS_DIR=~/DATA/Projects

# Cổng và địa chỉ nghe. Giữ 127.0.0.1, đừng mở ra ngoài khi chưa có HTTPS.
# PORT=4777
# HOST=127.0.0.1

# Chạy local bằng HTTP (http://localhost) thì phải đặt 0, nếu không sẽ không đăng nhập được.
# Trên server có HTTPS thì để mặc định (1).
# COOKIE_SECURE=0

# Domain được phép gọi API/WebSocket, cách nhau bằng dấu phẩy. Để trống thì so với header Host.
# Trên server sau CloudPanel nên đặt đúng domain.
# ALLOWED_ORIGINS=https://claude.domain-cua-anh.com

# Đặt 1 khi chạy sau reverse proxy (nginx) để lấy IP thật cho rate limit đăng nhập.
# TRUST_PROXY=1

# Dung lượng tối đa mỗi file upload (MB). Mặc định: 512
# MAX_UPLOAD_MB=512

# Tên socket tmux riêng của app. Mặc định: cpm
# CPM_TMUX_SOCKET=cpm

# Trình duyệt riêng cho từng phiên Claude (nút 🌐). Đặt 0 để tắt hẳn (không gắn Playwright MCP).
# CPM_BROWSER=0
# Số phút không ai dùng thì tắt Chromium. Mặc định: 15
# CPM_BROWSER_IDLE_MIN=15
# Đường dẫn Chromium/Chrome tự chọn (mặc định tìm trong cache Playwright rồi Chrome của máy).
# CPM_CHROME=/usr/bin/chromium
# Linux mặc định chạy --no-sandbox (Ubuntu 24.04 chặn sandbox khi không có root). Đặt 1 nếu máy hỗ trợ sandbox.
# CPM_CHROME_SANDBOX=1
